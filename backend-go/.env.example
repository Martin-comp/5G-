ADDR=:8080
# 云平台通常会自动提供 PORT，本地开发用 ADDR 即可。

# PostgreSQL 连接地址。Render 中创建 PostgreSQL 后，把 Internal Database URL
# 绑定为同一后端服务的 DATABASE_URL；本地留空时自动使用内存模式。
DATABASE_URL=

# 真实 OpenMAIC 服务根地址。没有部署/启动 OpenMAIC 时可以先留空，后端会使用本地规则助教。
# 示例：OPENMAIC_API_BASE=http://localhost:3001
OPENMAIC_API_BASE=

# OpenMAIC 提示接口路径。需要按实际 OpenMAIC 服务暴露的接口调整。
OPENMAIC_HINT_PATH=/api/ai/hint

# 如果 OpenMAIC 服务需要鉴权，在这里填写 token；不需要时留空。
OPENMAIC_API_KEY=

# DeepSeek 作为 AI 助教模型。部署到公网后建议在平台环境变量里填写，不要提交真实 key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 云端 TTS 播报。默认使用 OpenAI 兼容的 /v1/audio/speech 接口。
# 如果没有单独 TTS_API_KEY，会尝试读取 OPENAI_API_KEY。
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=onyx
TTS_FORMAT=mp3
